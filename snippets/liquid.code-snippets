{
	"tag assign": {
		"prefix": "assign",
		"body": [
			"{% assign ${1:variable_name} = ${2:value} %}"
		],
		"description": "Creates a new variable.\nhttps://shopify.dev/docs/api/liquid/tags/assign"
	},
	"tag block": {
		"prefix": "block",
		"body": [
			"{% block 'name', parameter: value %}",
			"\tcontent",
			"{% endblock %}"
		],
		"description": "Renders a reusable theme block directly from a Liquid template.\nhttps://shopify.dev/docs/api/liquid/tags/block"
	},
	"tag break": {
		"prefix": "break",
		"body": [
			"{% break %}"
		],
		"description": "Stops the rest of a file from rendering.\nhttps://shopify.dev/docs/api/liquid/tags/break"
	},
	"tag capture": {
		"prefix": "capture",
		"body": [
			"{% capture ${1:variable} %}",
			"\t${2:value}",
			"{% endcapture %}"
		],
		"description": "Creates a new variable with a string value.\nhttps://shopify.dev/docs/api/liquid/tags/capture"
	},
	"tag case": {
		"prefix": "case",
		"body": [
			"{% case ${1:variable} %}",
			"\t{% when ${2:first_value} %}",
			"\t\t${3:first_expression}",
			"\t{% when ${4:second_value} %}",
			"\t\t${5:second_expression}",
			"\t{% else %}",
			"\t\t${6:third_expression}",
			"{% endcase %}"
		],
		"description": "Renders a specific expression depending on the value of a specific variable.\nhttps://shopify.dev/docs/api/liquid/tags/case"
	},
	"tag comment": {
		"prefix": "comment",
		"body": [
			"{% comment %}",
			"\t${1:content}",
			"{% endcomment %}"
		],
		"description": "Prevents an expression from being rendered or output.\nhttps://shopify.dev/docs/api/liquid/tags/comment"
	},
	"tag content_for (1)": {
		"prefix": "content_for",
		"body": [
			"{% content_for 'blocks' %}"
		],
		"description": "Renderiza los bloques del tema que el comerciante agrega en el editor.\nhttps://shopify.dev/docs/api/liquid/tags/content_for"
	},
	"tag content_for (2)": {
		"prefix": "content_for",
		"body": [
			"{% content_for 'block', type: '${1:tipo}', id: '${2:id}' %}"
		],
		"description": "Renderiza un bloque estático, fijo en el código.\nhttps://shopify.dev/docs/api/liquid/tags/content_for"
	},
	"tag continue": {
		"prefix": "continue",
		"body": [
			"{% continue %}"
		],
		"description": "Causes a for loop to skip to the next iteration.\nhttps://shopify.dev/docs/api/liquid/tags/continue"
	},
	"tag cycle": {
		"prefix": "cycle",
		"body": [
			"{% cycle string, string, ... %}"
		],
		"description": "Loops through a group of strings and outputs them one at a time for each iteration of a for loop.\nhttps://shopify.dev/docs/api/liquid/tags/cycle"
	},
	"tag decrement": {
		"prefix": "decrement",
		"body": [
			"{% decrement ${1:variable_name} %}"
		],
		"description": "Creates a new variable, with a default value of -1, that's decreased by 1 with each subsequent call. > Caution: > Predefined Liquid objects can be overridden by variables with the same name. > To make sure that you can access all Liquid objects, make sure that your variable name doesn't match a predefined object's name.\nhttps://shopify.dev/docs/api/liquid/tags/decrement"
	},
	"tag doc": {
		"prefix": "doc",
		"body": [
			"{% doc %}",
			"\tRenders a message.",
			"",
			"\t@param {string} foo - A string value.",
			"\t@param {string} [bar] - An optional string value.",
			"",
			"\t@example",
			"\t{% render 'message', foo: 'Hello', bar: 'World' %}",
			"{% enddoc %}"
		],
		"description": "Documents template elements with annotations.\nhttps://shopify.dev/docs/api/liquid/tags/doc"
	},
	"tag echo": {
		"prefix": "echo",
		"body": [
			"{% liquid",
			"\techo ${1:expression}",
			"%}"
		],
		"description": "Outputs an expression.\nhttps://shopify.dev/docs/api/liquid/tags/echo"
	},
	"tag else": {
		"prefix": "else",
		"body": [
			"{% for ${1:variable} in ${2:array} %}",
			"\t${3:first_expression}",
			"{% else %}",
			"\t${4:second_expression}",
			"{% endfor %}"
		],
		"description": "Allows you to specify a default expression to execute when a for loop has zero length.\nhttps://shopify.dev/docs/api/liquid/tags/else"
	},
	"tag for": {
		"prefix": "for",
		"body": [
			"{% for ${1:variable} in ${2:array} %}",
			"\t${3:expression}",
			"{% endfor %}"
		],
		"description": "Renders an expression for every item in an array.\nhttps://shopify.dev/docs/api/liquid/tags/for"
	},
	"tag form": {
		"prefix": "form",
		"body": [
			"{% form '${1:form_type}' %}",
			"\t${2:content}",
			"{% endform %}"
		],
		"description": "Generates an HTML <form> tag, including any required <input> tags to submit the form to a specific endpoint.\nhttps://shopify.dev/docs/api/liquid/tags/form"
	},
	"tag if": {
		"prefix": "if",
		"body": [
			"{% if ${1:condition} %}",
			"\t${2:expression}",
			"{% endif %}"
		],
		"description": "Renders an expression if a specific condition is true.\nhttps://shopify.dev/docs/api/liquid/tags/if"
	},
	"tag increment": {
		"prefix": "increment",
		"body": [
			"{% increment ${1:variable_name} %}"
		],
		"description": "Creates a new variable, with a default value of 0, that's increased by 1 with each subsequent call. > Caution: > Predefined Liquid objects can be overridden by variables with the same name. > To make sure that you can access all Liquid objects, make sure that your variable name doesn't match a predefined object's name.\nhttps://shopify.dev/docs/api/liquid/tags/increment"
	},
	"tag javascript": {
		"prefix": "javascript",
		"body": [
			"{% javascript %}",
			"\t${1:javascript_code}",
			"{% endjavascript %}"
		],
		"description": "JavaScript code included in section, block and snippet files.\nhttps://shopify.dev/docs/api/liquid/tags/javascript"
	},
	"tag layout": {
		"prefix": "layout",
		"body": [
			"{% layout ${1:name} %}"
		],
		"description": "Specify which layout to use.\nhttps://shopify.dev/docs/api/liquid/tags/layout"
	},
	"tag liquid": {
		"prefix": "liquid",
		"body": [
			"{% liquid",
			"\t${1:expression}",
			"%}"
		],
		"description": "Allows you to have a block of Liquid without delimeters on each tag.\nhttps://shopify.dev/docs/api/liquid/tags/liquid"
	},
	"tag paginate": {
		"prefix": "paginate",
		"body": [
			"{% paginate ${1:array} by ${2:page_size} %}",
			"\t{% for ${3:item} in ${1:array} %}",
			"\t\t${4:forloop_content}",
			"\t{% endfor %}",
			"{% endpaginate %}"
		],
		"description": "Splits an array's items across multiple pages.\nhttps://shopify.dev/docs/api/liquid/tags/paginate"
	},
	"tag partial": {
		"prefix": "partial",
		"body": [
			"{% partial '${1:name}' %}",
			"\t${2:content}",
			"{% endpartial %}"
		],
		"description": "Marks a named, server-rendered region that JavaScript can refresh without a full page reload.\nhttps://shopify.dev/docs/api/liquid/tags/partial"
	},
	"tag raw": {
		"prefix": "raw",
		"body": [
			"{% raw %}",
			"\t${1:expression}",
			"{% endraw %}"
