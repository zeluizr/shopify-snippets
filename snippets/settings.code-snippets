{
	"setting text": {
		"prefix": "setting-text",
		"body": [
			"{",
			"\t\"type\": \"text\",",
			"\t\"id\": \"${1:titulo}\",",
			"\t\"label\": \"${2:Título}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Campo de texto de una línea.\nhttps://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings#text"
	},
	"setting textarea": {
		"prefix": "setting-textarea",
