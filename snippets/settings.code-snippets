	"setting color_scheme": {
		"prefix": "setting-color_scheme",
		"body": [
			"{",
			"\t\"type\": \"color_scheme\",",
			"\t\"id\": \"${1:esquema}\",",
			"\t\"label\": \"${2:Esquema de colores}\",",
			"\t\"default\": \"${3:scheme-1}\"",
			"}"
		],
		"description": "Selector de esquema de colores del tema.\nhttps://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings#color_scheme"
	},
	"setting color_scheme_group": {
		"prefix": "setting-color_scheme_group",
		"body": [
			"{",
			"\t\"type\": \"color_scheme_group\",",
			"\t\"id\": \"${1:esquemas}\",",
			"\t\"definition\": [",
			"\t\t{",
			"\t\t\t\"type\": \"color\",",
			"\t\t\t\"id\": \"fondo\",",
			"\t\t\t\"label\": \"Fondo\",",
			"\t\t\t\"default\": \"#FFFFFF\"",
			"\t\t},",
			"\t\t{",
			"\t\t\t\"type\": \"color\",",
			"\t\t\t\"id\": \"texto\",",
			"\t\t\t\"label\": \"Texto\",",
			"\t\t\t\"default\": \"#121212\"",
			"\t\t}",
			"\t],",
			"\t\"role\": {",
			"\t\t\"text\": \"texto\",",
			"\t\t\"background\": {",
			"\t\t\t\"solid\": \"fondo\",",
			"\t\t\t\"gradient\": \"fondo\"",
			"\t\t},",
			"\t\t\"links\": \"texto\",",
			"\t\t\"icons\": \"texto\",",
			"\t\t\"primary_button\": \"texto\",",
			"\t\t\"on_primary_button\": \"fondo\",",
			"\t\t\"primary_button_border\": \"texto\",",
			"\t\t\"secondary_button\": \"fondo\",",
			"\t\t\"on_secondary_button\": \"texto\",",
			"\t\t\"secondary_button_border\": \"texto\"",
			"\t}",
			"}"
		],
		"description": "Grupo de esquemas de colores (solo en config/settings_schema.json).\nhttps://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings#color_scheme_group"
	},
