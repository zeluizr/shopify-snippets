			"\t\"type\": \"textarea\",",
			"\t\"id\": \"${1:texto}\",",
			"\t\"label\": \"${2:Texto}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Campo de texto de varias líneas.\nhttps://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings#textarea"
	},
